@article{hughesTrainingPhotonicNeural2018,
  title = {Training of Photonic Neural Networks through in Situ Backpropagation and Gradient Measurement},
  author = {Hughes, Tyler W. and Minkov, Momchil and Shi, Yu and Fan, Shanhui},
  date = {2018-07-20},
  journaltitle = {Optica},
  shortjournal = {Optica, OPTICA},
  volume = {5},
  number = {7},
  pages = {864--871},
  publisher = {Optica Publishing Group},
  issn = {2334-2536},
  doi = {10.1364/OPTICA.5.000864},
  url = {https://opg.optica.org/optica/abstract.cfm?uri=optica-5-7-864},
  urldate = {2026-07-28},
  abstract = {Recently, integrated optics has gained interest as a hardware platform for implementing machine learning algorithms. Of particular interest are artificial neural networks, since matrix-vector multiplications, which are used heavily in artificial neural networks, can be done efficiently in photonic circuits. The training of an artificial neural network is a crucial step in its application. However, currently on the integrated photonics platform there is no efficient protocol for the training of these networks. In this work, we introduce a method that enables highly efficient, in situ training of a photonic neural network. We use adjoint variable methods to derive the photonic analogue of the backpropagation algorithm, which is the standard method for computing gradients of conventional neural networks. We further show how these gradients may be obtained exactly by performing intensity measurements within the device. As an application, we demonstrate the training of a numerically simulated photonic artificial neural network. Beyond the training of photonic machine learning implementations, our method may also be of broad interest to experimental sensitivity analysis of photonic systems and the optimization of reconfigurable optics platforms.},
  langid = {english},
  keywords = {Integrated photonics,Inverse design,Machine learning,Neural networks,Optical computing,Optical systems},
  file = {C:\Users\tim\Zotero\storage\YQBJEI8Q\Hughes et al. - 2018 - Training of photonic neural networks through in situ backpropagation and gradient measurement.pdf}
}

@article{hermansTrainableHardwareDynamical2015,
  title = {Trainable Hardware for Dynamical Computing Using Error Backpropagation through Physical Media},
  author = {Hermans, Michiel and Burm, Micha{\"e}l and Van Vaerenbergh, Thomas and Dambre, Joni and Bienstman, Peter},
  year = 2015,
  month = mar,
  journal = {Nature Communications},
  volume = {6},
  number = {1},
  pages = {6729},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/ncomms7729},
  urldate = {2026-07-28},
  abstract = {Neural networks are currently implemented on digital Von Neumann machines, which do not fully leverage their intrinsic parallelism. We demonstrate how to use a novel class of reconfigurable dynamical systems for analogue information processing, mitigating this problem. Our generic hardware platform for dynamic, analogue computing consists of a reciprocal linear dynamical system with nonlinear feedback. Thanks to reciprocity, a ubiquitous property of many physical phenomena like the propagation of light and sound, the error backpropagation---a crucial step for tuning such systems towards a specific task---can happen in hardware. This can potentially speed up the optimization process significantly, offering important benefits for the scalability of neuro-inspired hardware. In this paper, we show, using one experimentally validated and one conceptual example, that such systems may provide a straightforward mechanism for constructing highly scalable, fully dynamical analogue computers.},
  copyright = {2015 The Author(s)},
  langid = {english},
  keywords = {Computational science,Theoretical physics},
  file = {C:\Users\tim\Zotero\storage\WK9RYD33\Hermans et al. - 2015 - Trainable hardware for dynamical computing using error backpropagation through physical media.pdf}
}

